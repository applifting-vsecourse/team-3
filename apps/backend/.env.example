# Basic Auth Configuration
BETTER_AUTH_SECRET=development_secret_key_change_in_production
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=adminpassword26

# Environment Configuration
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:4050
FRONTEND_URL=http://localhost:3050
FRONTEND_RESET_PASSWORD_ROUTE=reset-password

# Database Configuration
DATABASE_URL=postgresql://quacker:quacker@localhost:5433/quacker
# Also have Quacker locally? Give HobbyHub its own container and port (see README):
# COMPOSE_PROJECT_NAME=hobbyhub
# Then use 5434 in DATABASE_URL too.
# DB_PORT=5434

# Server Configuration
PORT=4050

# Mail Configuration
# Resolution order (first match wins): Resend → SMTP → ConsoleMailerAdapter (dev logs;
# with NODE_ENV=production only the recipient and subject, never the links).
# Set RESEND_API_KEY to use Resend.
RESEND_API_KEY=
# Optional sender: SMTP defaults to SMTP_USERNAME; Resend to onboarding@resend.dev.
# Set your verified sender explicitly, e.g. HobbyHub <sender@example.com>.
EMAIL_FROM=
# Or set all three SMTP_* (HOST, USERNAME, PASSWORD) to use SMTP instead.
SMTP_HOST=
SMTP_SECURE=true
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD= 

# Simulated inbox (#58): shows the verification link in the app when there is no
# e-mail service. Empty = off when NODE_ENV=production, on otherwise.
SIMULATED_INBOX=

# Proxies in front of the backend that add to X-Forwarded-For (Express trust proxy).
# 0 = none (local dev); staging sets 1 in apps/backend/Dockerfile.deploy.
TRUST_PROXY_HOPS=0

# API docs: Swagger (/api/docs) and BetterAuth's reference page
# (/api/auth/reference). Empty = off when NODE_ENV=production, on otherwise.
# true/false forces it; staging sets true in apps/backend/Dockerfile.deploy.
API_DOCS=

# Sign-in with Google (#154). Both set = „Pokračovat přes Google“ on /login and
# /signup; empty = e-mail and password only. How to get them:
# docs/prihlaseni-pres-google.md (redirect URI: <BACKEND_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Passwords from data breaches are refused (#153, Have I Been Pwned via
# BetterAuth's plugin; only a 5-character hash prefix leaves the server).
# Empty = on when NODE_ENV=production, off otherwise (local dev and tests make
# no network calls). true/false forces it, e.g. false while the service is down.
PWNED_PASSWORDS_CHECK=
