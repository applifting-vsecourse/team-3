// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Datový model HobbyHub pro celé MVP (US-01 až US-19, BACKLOG.md). Přehled a ER
// diagram jsou v docs/datovy-model.md – při změně schématu aktualizuj i ten.
// Komentář `B-0XX` u modelu říká, který úkol backlogu model nebo pole zavádí.

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enumy
// ---------------------------------------------------------------------------

/// `admin` = superadmin aplikace (B-003: nový enum nevytvářet).
enum UserRole {
  user
  admin

  @@map("user_role")
}

/// B-014: kdo vidí fotku, bio a navštívené akce v profilu.
enum ProfileVisibility {
  everyone
  organizers
  nobody

  @@map("profile_visibility")
}

/// B-020: úroveň akce (začátečník / pokročilý / všichni).
enum EventLevel {
  beginner
  advanced
  all

  @@map("event_level")
}

/// B-020: způsob přihlašování, výchozí bez schválení.
enum ApprovalMode {
  open
  approval

  @@map("approval_mode")
}

/// B-020: soukromá akce = dostupná jen přes odkaz, `members` = jen pro členy skupiny (B-055).
enum EventVisibility {
  public
  private
  members

  @@map("event_visibility")
}

/// B-020: `hidden` a `deleted` nastavuje jen superadmin (B-063), akce se fyzicky nemaže (Q11).
enum EventStatus {
  published
  cancelled
  hidden
  deleted

  @@map("event_status")
}

/// B-030
enum ParticipationStatus {
  pending
  approved
  rejected
  withdrawn
  removed

  @@map("participation_status")
}

/// B-050: `closed` = neveřejná skupina, do které se žádá.
enum GroupType {
  public
  closed

  @@map("group_type")
}

/// B-050, B-051: skupina se nemaže ani neruší, jen deaktivuje.
enum GroupStatus {
  active
  inactive

  @@map("group_status")
}

/// B-050, B-054: všichni správci mají stejná práva.
enum GroupMemberRole {
  admin
  member

  @@map("group_member_role")
}

/// B-050, B-053
enum GroupMemberStatus {
  pending
  active
  blocked

  @@map("group_member_status")
}

/// B-061. `rating` = hodnocení akce a organizátora, `participant_rating` = hodnocení účastníka
/// (PO 4. 11.: jeho komentář je na veřejném profilu).
enum ReportTargetType {
  user
  event
  group
  rating
  participant_rating

  @@map("report_target_type")
}

/// B-061
enum ReportReason {
  spam
  fraud
  inappropriate
  other

  @@map("report_reason")
}

/// B-061, B-063
enum ReportStatus {
  open
  rejected
  resolved

  @@map("report_status")
}

/// B-063: zásahy superadmina, každý jde vrátit.
enum ModerationActionType {
  block_user
  hide_event
  delete_event
  delete_rating

  @@map("moderation_action_type")
}

/// B-070
enum PaymentType {
  subscription
  promotion

  @@map("payment_type")
}

/// B-070: platbu potvrzuje jen superadmin.
enum PaymentStatus {
  pending
  confirmed
  rejected

  @@map("payment_status")
}

// ---------------------------------------------------------------------------
// Účty (BetterAuth) – tabulky session, account a verification spravuje BetterAuth
// ---------------------------------------------------------------------------

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

/// Uživatel. Pole do `displayUsername` spravuje BetterAuth, zbytek je profil HobbyHubu (B-003, B-013, B-014).
/// Fotka profilu = pole `image` (v MVP jen URL, Q3).
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?   @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  role          UserRole  @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  // Profil (B-003, B-013)
  bio            String?        @db.VarChar(500)
  homeLocalityId String?
  homeLocality   Locality?      @relation(fields: [homeLocalityId], references: [id], onDelete: SetNull)
  interests      UserInterest[]

  // Viditelnost údajů v profilu (B-014)
  photoVisibility      ProfileVisibility @default(everyone)
  bioVisibility        ProfileVisibility @default(everyone)
  pastEventsVisibility ProfileVisibility @default(everyone)

  // Souhlasy (B-016), blokace superadminem (B-063), smazání účtu (B-080)
  ageConfirmedAt  DateTime?
  termsAcceptedAt DateTime?
  onboardingCompletedAt DateTime?
  blockedAt       DateTime?
  blockedReason   String?   @db.Text
  deletedAt       DateTime?

  organizedEvents        Event[]             @relation("EventOrganizer")
  participations         Participation[]
  groupMemberships       GroupMember[]
  ratings                Rating[]
  reports                Report[]            @relation("ReportReporter")
  resolvedReports        Report[]            @relation("ReportResolver")
  moderationActions      ModerationAction[]  @relation("ModerationAdmin")
  revertedModerations    ModerationAction[]  @relation("ModerationReverter")
  payments               Payment[]           @relation("PaymentPayer")
  confirmedPayments      Payment[]           @relation("PaymentConfirmer")
  subscription           Subscription?
  sentEventMessages      EventMessage[]
  sentAnnouncements      GroupAnnouncement[]
  notificationLogs       NotificationLog[]
  sentFriendRequests     Friendship[]        @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]        @relation("FriendshipAddressee")
  notifications          Notification[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

// ---------------------------------------------------------------------------
// Číselníky (B-002)
// ---------------------------------------------------------------------------

/// Kategorie aktivit (první úroveň). Ikona odpovídá variantě komponenty `Activity tile` ve Figmě.
model ActivityCategory {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  icon       String
  sortOrder  Int
  activities Activity[]

  @@map("activity_category")
}

/// Aktivita (druhá úroveň). Akce, skupina i zájem v profilu se váže vždy na aktivitu, ne na kategorii.
/// `keywords` = synonyma pro hledání (využije #57 ve sprintu 3).
model Activity {
  id         String           @id @default(cuid())
  slug       String           @unique
  name       String
  categoryId String
  category   ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sortOrder  Int
  keywords   String[]         @default([])

  events          Event[]
  groups          Group[]
  interestedUsers UserInterest[]

  @@index([categoryId])
  @@map("activity")
}

/// Lokalita: město, nebo městská část (`parentId` ukazuje na město). Souřadnice = přibližný střed.
/// `slug` je stabilní klíč pro seed a odkazy; jméno unikátní není (víc obcí „Nová Ves“).
model Locality {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  parentId String?
  parent   Locality?  @relation("LocalityParent", fields: [parentId], references: [id], onDelete: Restrict)
  children Locality[] @relation("LocalityParent")
  lat      Float
  lng      Float

  users  User[]
  events Event[]
  groups Group[]

  @@index([parentId])
  @@map("locality")
}

/// Zájmy v profilu: vazba M:N uživatel × aktivita (B-003).
model UserInterest {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, activityId])
  @@index([activityId])
  @@map("user_interest")
}

// ---------------------------------------------------------------------------
// Akce a účast (B-020, B-030)
// ---------------------------------------------------------------------------

/// Jeden model pro akce jednotlivců i skupin (`groupId`, B-055). Kapacitu (`approvedCount`,
/// `missingToMin`, `freeSpots`, `isFull`) počítá doménová logika jen ze schválených účastí.
model Event {
  id              String          @id @default(cuid())
  title           String
  description     String?         @db.Text
  activityId      String
  activity        Activity        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  startsAt        DateTime
  endsAt          DateTime?
  lat             Float
  lng             Float
  address         String
  localityId      String
  locality        Locality        @relation(fields: [localityId], references: [id], onDelete: Restrict)
  minParticipants Int
  maxParticipants Int
  /// Kč, celé číslo
  price           Int?
  level           EventLevel?
  equipment       String?
  approvalMode    ApprovalMode    @default(open)
  /// Organizátor chce e-mail ke každé přihlášce na akci bez schvalování (#86);
  /// upozornění v centru dostane vždy, žádosti o účast chodí e-mailem vždy.
  emailOnJoin     Boolean         @default(false)
  visibility      EventVisibility @default(public)
  organizerUserId String
  organizer       User            @relation("EventOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  groupId         String?
  group           Group?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  status          EventStatus     @default(published)
  cancelReason    String?         @db.Text
  cancelledAt     DateTime?
  /// Topování (B-073): po potvrzení platby = startsAt
  promotedUntil   DateTime?
  /// Obrázek nahraný organizátorem (#77); bez něj fotka aktivity
  imageKey        String?         @unique
  image           UploadedImage?  @relation(fields: [imageKey], references: [key], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  participations     Participation[]
  ratings            Rating[]
  participantRatings ParticipantRating[]
  payments           Payment[]
  messages           EventMessage[]
  notifications      NotificationLog[]

  @@index([status, visibility, startsAt])
  @@index([activityId])
  @@index([localityId])
  @@index([organizerUserId])
  @@index([groupId])
  @@map("event")
}

/// Obrázek, který nahrál organizátor akce nebo správce skupiny (#77): nahrává se
/// JPEG, PNG nebo WebP do 5 MB, ukládá se zmenšený na WebP (šířka nejvýš 1600 px) a s
/// malou variantou pro karty. Bajty jsou v databázi, protože staging nemá trvalý
/// disk (kontejner se při každém nasazení vytvoří znovu) a databáze ano. `key`
/// je náhodné UUID a je součástí adresy obrázku; nový obrázek = nový klíč, takže
/// adresa jde cachovat navždy. Výměna nebo odebrání starý řádek smaže.
model UploadedImage {
  key         String   @id @default(uuid())
  /// `image/jpeg`, `image/png` nebo `image/webp`, podle obsahu souboru, ne podle toho, co poslal prohlížeč
  contentType String
  data        Bytes
  /// v bajtech
  size        Int
  /// Malá varianta pro karty (WebP, šířka nejvýš 480 px)
  small       Bytes
  createdAt   DateTime @default(now())

  event Event?
  group Group?

  @@map("uploaded_image")
}

/// Přihláška na akci. Organizátor se může přihlásit na vlastní akci (Q12).
/// `approvedAt` = kdy byla účast schválena (řazení účastníků ve správě akce, D-03),
/// `attendedAt` = evidence docházky (B-072).
model Participation {
  id         String              @id @default(cuid())
  eventId    String
  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     ParticipationStatus
  message    String?             @db.Text
  approvedAt DateTime?
  attendedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt
  /// Hodnocení účastníka organizátorem (#180), nanejvýš jedno
  rating     ParticipantRating?

  @@unique([eventId, userId])
  @@index([userId])
  @@map("participation")
}

/// Zpráva organizátora všem schváleným účastníkům (B-042). Záznam slouží pro limit 10 zpráv na akci za den.
model EventMessage {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@map("event_message")
}

/// Doručení plánovaného e-mailu (B-043); sentAt je null, dokud transport nepotvrdí přijetí.
/// `key` je deterministický, např. `event-reminder:<eventId>:<userId>`.
model NotificationLog {
  id          String    @id @default(cuid())
  key         String    @unique
  type        String
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt      DateTime?
  claimToken  String?
  lockedUntil DateTime?
  attempts    Int       @default(0)

  @@index([eventId])
  @@map("notification_log")
}

/// Datum zapnutí výzev k hodnocení. Platí pro všechny instance i restarty.
model RatingInvitationSchedule {
  id          Int      @id
  activatedAt DateTime

  @@map("rating_invitation_schedule")
}

// ---------------------------------------------------------------------------
// Skupiny (B-050)
// ---------------------------------------------------------------------------

/// Skupina má právě jednu aktivitu a jednu lokalitu. Fotka je nahraný soubor (`imageKey`, #77), bez ní fotka aktivity.
model Group {
  id            String         @id @default(cuid())
  name          String
  description   String?        @db.Text
  /// Fotka nahraná správcem (#77); bez ní fotka aktivity
  imageKey      String?        @unique
  image         UploadedImage? @relation(fields: [imageKey], references: [key], onDelete: SetNull)
  activityId    String
  activity      Activity       @relation(fields: [activityId], references: [id], onDelete: Restrict)
  localityId    String
  locality      Locality       @relation(fields: [localityId], references: [id], onDelete: Restrict)
  type          GroupType
  status        GroupStatus    @default(active)
  deactivatedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  members       GroupMember[]
  events        Event[]
  announcements GroupAnnouncement[]

  @@index([status])
  @@index([activityId])
  @@index([localityId])
  @@map("group")
}

/// Členství ve skupině. Zakladatel je první správce (`admin`).
model GroupMember {
  id        String            @id @default(cuid())
  groupId   String
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupMemberRole   @default(member)
  status    GroupMemberStatus
  message   String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_member")
}

/// Oznámení správce všem aktivním členům skupiny (#194). Je na stránce skupiny pro členy a správce,
/// přijde e-mailem; záznam slouží i pro denní limit oznámení na skupinu.
model GroupAnnouncement {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
  @@map("group_announcement")
}

// ---------------------------------------------------------------------------
// Důvěra a administrace (B-060 až B-063)
// ---------------------------------------------------------------------------

/// Hodnocení akce a organizátora od účastníka, hvězdičky 1–5. U akce skupiny se hodnocení organizátora
/// počítá ke skupině. `deletedAt` = smazáno superadminem (jde vrátit, B-063). Hvězdičky 1–5 hlídá i
/// databáze: CHECK v migraci (review #313), Prisma ho ve schématu neumí zapsat. `comment` nepovinný,
/// max. 500 znaků, i v databázi (`VarChar(500)`) – stejně jako u `ParticipantRating`.
model Rating {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventStars     Int
  organizerStars Int
  comment        String?   @db.VarChar(500)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
  @@map("rating")
}

/// Hodnocení účastníka organizátorem akce (#180, B-060), hvězdičky 1–5. Jedno na účastníka
/// a akci, jen po skončení akce a jen u `approved` účasti; hodnotí jen organizátor akce, ne
/// sám sebe (hlídá aplikace, decideParticipantRating). Složený cizí klíč na účast zaručuje,
/// že hodnocený byl na akci přihlášený. `stars` 1–5 hlídá i databáze: CHECK v migraci,
/// Prisma ho ve schématu neumí zapsat. `deletedAt` = smazáno superadminem (jde vrátit, B-063).
/// `comment` nepovinný, max. 500 znaků jako u `Rating` (PO 4. 11.); je na veřejném profilu,
/// proto délku hlídá i databáze (`VarChar(500)` jako `bio`).
model ParticipantRating {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  participation Participation @relation(fields: [eventId, participantId], references: [eventId, userId], onDelete: Cascade)
  stars         Int
  comment       String?       @db.VarChar(500)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@unique([eventId, participantId])
  @@index([participantId])
  @@map("participant_rating")
}

/// Nahlášení. Cíl je polymorfní (`targetType` + `targetId`), proto bez cizího klíče.
/// `reporterId` nikdy nejde ven mimo admin API (B-061).
model Report {
  id           String           @id @default(cuid())
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  comment      String?          @db.Text
  reporterId   String
  reporter     User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  status       ReportStatus     @default(open)
  resolvedById String?
  resolvedBy   User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
  @@map("report")
}

/// Zásah superadmina a jeho historie (B-063): kdo, co, kdy, důvod, vráceno.
model ModerationAction {
  id           String               @id @default(cuid())
  type         ModerationActionType
  targetType   ReportTargetType
  targetId     String
  reason       String               @db.Text
  adminId      String
  admin        User                 @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  revertedAt   DateTime?
  revertedById String?
  revertedBy   User?                @relation("ModerationReverter", fields: [revertedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("moderation_action")
}

// ---------------------------------------------------------------------------
// Monetizace (B-070 až B-073)
// ---------------------------------------------------------------------------

/// Simulovaná platba bez brány, potvrzuje ji superadmin. `eventId` jen u topování.
model Payment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation("PaymentPayer", fields: [userId], references: [id], onDelete: Restrict)
  type          PaymentType
  eventId       String?
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// Kč
  amount        Int
  status        PaymentStatus @default(pending)
  confirmedById String?
  confirmedBy   User?         @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
  @@index([eventId])
  @@map("payment")
}

/// Předplatné organizátora (B-071): potvrzená platba `subscription` prodlouží `validUntil` o měsíc.
model Subscription {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  validUntil DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("subscription")
}

// ---------------------------------------------------------------------------
// Přátelé (B-017, #307)
// ---------------------------------------------------------------------------

/// pending = žádost čeká; accepted = přátelé; rejected = příjemce tiše odmítl
/// (odesílatel dál vidí „Žádost odeslána“ a může ji zrušit).
enum FriendshipStatus {
  pending
  accepted
  rejected

  @@map("friendship_status")
}

/// Jedna žádost o přátelství na dvojici lidí, bez ohledu na to, kdo žádal.
/// `pairKey` jsou obě ID seřazená a spojená dvojtečkou (`friendshipPairKey`):
/// unikátní index hlídá dvojici v databázi, i při souběžných žádostech.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  pairKey     String           @unique
  status      FriendshipStatus @default(pending)
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([requesterId])
  @@index([addresseeId])
  @@map("friendship")
}

// ---------------------------------------------------------------------------
// Upozornění v aplikaci (B-044, #86)
// ---------------------------------------------------------------------------

/// Druh upozornění, řádky v `docs/navrh-upozorneni.md`. Podle druhu vede proklik
/// (`notificationPath`): správa akce, detail akce, skupina, žádosti o přátelství, profil.
enum NotificationType {
  request_received
  participant_joined
  participant_left
  request_approved
  request_rejected
  event_changed
  event_cancelled
  event_message
  group_announcement
  group_join_request
  group_request_approved
  group_request_rejected
  friend_request
  friend_accepted

  @@map("notification_type")
}

enum NotificationTargetType {
  event
  group
  user

  @@map("notification_target_type")
}

/// Upozornění v centru (zvonek). Vzniká ze stejné události jako e-mail (#177).
/// `text` je hotová krátká zpráva uložená při vzniku; cíl (`targetType` + `targetId`)
/// je bez cizího klíče jako u `Report`, existenci ověří detail při prokliku.
/// Nepřečtené = `readAt` je null.
model Notification {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  targetType NotificationTargetType
  targetId   String
  text       String
  createdAt  DateTime               @default(now())
  readAt     DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Testovací data (#181)
// ---------------------------------------------------------------------------

/// Verze testovacích dat v databázi, jeden řádek na sadu dat (`key` = "demo"). Seed ji
/// porovná se SEED_DATA_VERSION v kódu a při rozdílu data vymění. Smaže přitom jen akce
/// a skupiny, které sám vložil (`eventIds`, `groupIds`); co pod demo účty založili
/// testeři, zůstane. Bez cizích klíčů: řádky mezitím mohl smazat někdo jiný.
model SeedState {
  key       String   @id
  version   Int
  eventIds  String[] @default([])
  groupIds  String[] @default([])
  appliedAt DateTime @default(now())

  @@map("seed_state")
}
