# Build context must be the repo root:
#   docker build -f apps/backend/Dockerfile.deploy -t backend .

# --- Build stage: install all deps, generate Prisma client, compile Nest ---
FROM node:24.22.2-alpine AS builder

RUN apk add --no-cache openssl
RUN corepack enable


WORKDIR /app

# Every workspace member's manifest has to be present before install: pnpm
# reconciles the lockfile against the whole workspace, and --frozen-lockfile
# fails if a member is missing. Manifests only, so editing source code doesn't
# invalidate the install layer.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/

RUN pnpm install --frozen-lockfile

COPY apps/backend ./apps/backend

ARG CI_COMMIT_SHA
ENV CI_COMMIT_SHA=$CI_COMMIT_SHA

# Runs `prisma generate && nest build`.
RUN pnpm --filter backend build


# --- Production deps: the same lockfile, minus everything only used to build ---
FROM node:24.22.2-alpine AS prod-deps

RUN apk add --no-cache openssl
RUN corepack enable

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/

RUN pnpm install --frozen-lockfile --prod --no-optional --filter backend


# --- Runtime stage: production deps + compiled output, nothing else ---
FROM node:24.22.2-alpine

RUN apk add --no-cache openssl
RUN corepack enable

WORKDIR /app

COPY --from=builder /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/package.json ./
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/apps/backend/node_modules ./apps/backend/node_modules

# The Prisma client is generated into src, so it compiles into dist and needs
# no regeneration here. prisma/ and its config come along for `migrate deploy`.
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/package.json /app/apps/backend/prisma.config.ts ./apps/backend/
COPY --from=builder /app/apps/backend/prisma ./apps/backend/prisma

ARG CI_COMMIT_SHA
ENV CI_COMMIT_SHA=$CI_COMMIT_SHA

# Simulated inbox on staging until real e-mail works (#165): the repo variable
# SIMULATED_INBOX=false in deploy.yml turns it off. Delete for real production.
ARG SIMULATED_INBOX="true"
ENV SIMULATED_INBOX=$SIMULATED_INBOX
# Swagger (/api/docs) and BetterAuth's reference page, kept on for the team on
# staging (#229, N-9). Delete for real production.
ENV API_DOCS=true
# Staging's demo accounts. Delete for real production.
ENV SEED_DEMO_DATA=true
# Their password comes from the GitHub secret SEED_DEMO_PASSWORD (deploy.yml),
# never from the repo (N-3, audit #172). Empty = the seed skips the demo data.
# Anyone who can pull this image can read it: use a password for staging only.
ARG SEED_DEMO_PASSWORD=""
ENV SEED_DEMO_PASSWORD=$SEED_DEMO_PASSWORD
# Google sign-in and real e-mail on staging (#165), from GitHub secrets and
# variables via build-args in deploy.yml — the course's way: Coolify's own
# variables are fixed. Empty = off (no Google button; e-mails only logged).
# Anyone who can pull this image can read them: use staging-only keys.
ARG GOOGLE_CLIENT_ID=""
ENV GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
ARG GOOGLE_CLIENT_SECRET=""
ENV GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
ARG SMTP_HOST=""
ENV SMTP_HOST=$SMTP_HOST
ARG SMTP_PORT="465"
ENV SMTP_PORT=$SMTP_PORT
ARG SMTP_SECURE="true"
ENV SMTP_SECURE=$SMTP_SECURE
ARG SMTP_USERNAME=""
ENV SMTP_USERNAME=$SMTP_USERNAME
ARG SMTP_PASSWORD=""
ENV SMTP_PASSWORD=$SMTP_PASSWORD
# Optional: without it SMTP sends from SMTP_USERNAME (#165)
ARG EMAIL_FROM=""
ENV EMAIL_FROM=$EMAIL_FROM

USER node
WORKDIR /app/apps/backend

CMD ["pnpm", "start:migrate:prod"]
