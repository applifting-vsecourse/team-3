# Root env for the production stack (docker-compose.yml).
# Local test: cp .env.example .env && docker compose up --build
#
# NOT used by `pnpm dev` — that reads apps/backend/.env and apps/frontend/.env.
# The backend has more knobs than are listed here (SMTP, logging, …); see
# apps/backend/.env.example for the full set. Anything you add to this file is
# forwarded to the backend container as-is.

# --- Database (compose creates it with these credentials) ---
POSTGRES_USER=quacker
POSTGRES_PASSWORD=change_me
POSTGRES_DB=quacker

# --- Auth ---
# Generate for real deployments: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_in_production
SUPERADMIN_EMAIL=admin@example.com
# at least 10 characters with a letter and a digit (B-010), or the seed can't create the superadmin
SUPERADMIN_PASSWORD=change_me_2026

# --- Public URLs (the two domains this stack answers on) ---
# BACKEND_URL is also baked into the frontend bundle at BUILD time, so
# changing it needs a rebuild, not just a restart.
# The backend accepts browser requests only from these two origins.
BACKEND_URL=http://localhost:4050
FRONTEND_URL=http://localhost:3050

# --- Host ports (Coolify routes through its proxy; these are for local runs) ---
BACKEND_HOST_PORT=4050
FRONTEND_HOST_PORT=3050

# --- Sign-in with Google (#154; empty = e-mail and password only) ---
# OAuth client from Google Cloud Console, see docs/prihlaseni-pres-google.md.
# Redirect URI to register there: <BACKEND_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Passwords from data breaches (#153; on in this stack, NODE_ENV=production) ---
# Sign-up, password change and reset refuse passwords Have I Been Pwned knows.
# Uncomment to switch it off, e.g. while that service is down (it fails closed).
# PWNED_PASSWORDS_CHECK=false

# --- Simulated inbox (#58): the image has it on, for staging without e-mail ---
# It lets anyone verify any address, so real production must switch it off.
# SIMULATED_INBOX=false

# --- API docs (#229): the image has them on, for staging ---
# Swagger (/api/docs) and BetterAuth's reference page (/api/auth/reference).
# Real production should switch them off.
# API_DOCS=false

# --- Demo data: the image has it on, for staging ---
# Real production must switch it off, before the first start.
# SEED_DEMO_DATA=false
# Locally the demo accounts use the password from the repo (DEMO_PASSWORD).
# In production (staging) it must come from here, the repo one is refused (N-3);
# staging gets it from the GitHub secret SEED_DEMO_PASSWORD.
# SEED_DEMO_PASSWORD=

# --- Mail (unset = the backend log gets each e-mail's recipient and subject) ---
RESEND_API_KEY=
EMAIL_FROM="HobbyHub <onboarding@resend.dev>"
